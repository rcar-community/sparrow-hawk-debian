#!/bin/sh
# Helper for running HostPC-built AI SDK applications (e.g. HyCo/Reaction)
# on Sparrow Hawk Debian, which ships OpenCV 4.10 while such applications
# are typically linked against OpenCV 4.9.0.
#
# This script never runs automatically (no postinst hook). The operator
# must invoke each subcommand explicitly.
set -eu

PROG=$(basename "$0")

usage() {
	cat <<EOF
Usage: ${PROG} <command> [args...]

Commands:
  lib-symlink
      Create the shared library ABI compatibility symlinks needed by
      HostPC-built AI SDK applications on this board (OpenCV, libcrypt).
      The library patterns/target versions are fixed in this script;
      bump the package version if a dependency's expected ABI changes.

  user-setup [username]
      Let a non-root user run AI SDK applications: allow realtime
      priority (rtprio 99, needed for SCHED_FIFO threads in OSAL) and
      create /tmp/tvm-rcar-osal-lock owned by that user on every boot
      (needed by the TVM runtime). The user is <username>, else the
      user who ran sudo (\$SUDO_USER). Only one user can use the TVM
      lock file at a time; re-running with another user switches it.
      The lock file is owned by that user, so root can no longer open
      it (fs.protected_regular); do not use together with root runs.
      Use user-reset to undo this and run applications as root again.

  user-reset
      Undo user-setup: remove the rtprio limit and the boot-time lock
      file rule, and delete /tmp/tvm-rcar-osal-lock so that root can
      create it again. Does nothing if user-setup was not run.

  all
      Run lib-symlink and unlock-root in sequence (user-setup is not
      included; it is for non-root use and must be run explicitly).

  unlock-root
      Unlock the root account, set its password interactively (runs
      'passwd root'), and enable password-based root SSH login
      (PermitRootLogin yes in sshd_config). Required by AI SDK
      applications that only work when run as root over SSH.
      WARNING: this weakens SSH security by allowing password
      authentication as root; only use it on an isolated/trusted
      network.

Every invocation checks whether the uio devices (/dev/uio*) required
by AI SDK applications are present, and warns if they are not.
EOF
	exit 1
}

# Library ABI compatibility symlinks needed by HostPC-built AI SDK apps
# on this board. Update these (and bump the package version) when the
# apps' expected ABI or this board's installed library version changes.
# Debian's OpenCV packaging uses its own SONAME scheme (major + 2-digit
# minor, no dots, e.g. 4.9 -> "409", 4.10 -> "410") rather than upstream
# CMake's dotted "major.minor".
#   pattern           target_version
LIB_SYMLINK_TABLE='
libopencv_*        409
libcrypt           2
'

create_lib_symlink() {
	pattern="$1"
	target_version="$2"

	# Prefer the SONAME (shortest, dot-free version suffix) over the
	# full-version real file (e.g. "410" over "4.10.0").
	sample=$(find /usr/lib -name "${pattern}.so.[0-9]*" 2>/dev/null |
		awk -F. '{print NF, $0}' | sort -n | head -n1 | cut -d' ' -f2-)
	if [ -z "${sample}" ]; then
		echo "warning: no ${pattern}.so.* found under /usr/lib; skipping" >&2
		return 0
	fi
	current_version=$(basename "${sample}" | sed -n 's/^.*\.so\.//p')

	if [ "${target_version}" = "${current_version}" ]; then
		echo "${pattern}: target and current versions are identical (${current_version}); nothing to do"
		return 0
	fi

	echo "Linking installed ${pattern} libraries (${current_version}) as ${target_version}"

	found=0
	for lib in $(find /usr/lib -name "${pattern}.so.${current_version}" 2>/dev/null); do
		dir=$(dirname "${lib}")
		base=$(basename "${lib}" ".so.${current_version}")
		linkname="${dir}/${base}.so.${target_version}"

		if [ -e "${linkname}" ]; then
			echo "skip (already exists): ${linkname}"
			continue
		fi

		ln -sv "$(basename "${lib}")" "${linkname}"
		found=$((found + 1))
	done

	if [ "${found}" -eq 0 ]; then
		echo "warning: no ${pattern}.so.${current_version} found under /usr/lib" >&2
	fi
}

cmd_lib_symlink() {
	echo "${LIB_SYMLINK_TABLE}" | while read -r pattern target_version; do
		[ -n "${pattern}" ] || continue
		create_lib_symlink "${pattern}" "${target_version}"
	done
	ldconfig
}

cmd_unlock_root() {
	echo "WARNING: this enables password-based root SSH login (PermitRootLogin yes)." >&2
	echo "         This weakens SSH security; only use it on an isolated/trusted network." >&2

	if ! grep -q "^PermitRootLogin\s\+yes" /etc/ssh/sshd_config; then
		if grep -q "^PermitRootLogin\s" /etc/ssh/sshd_config; then
			sed -i -e "s/^PermitRootLogin\s.*/PermitRootLogin yes/" /etc/ssh/sshd_config
		elif grep -q "^#PermitRootLogin" /etc/ssh/sshd_config; then
			sed -i -e "/^#PermitRootLogin/a PermitRootLogin yes" /etc/ssh/sshd_config
		else
			echo "PermitRootLogin yes" >>/etc/ssh/sshd_config
		fi

		if command -v systemctl >/dev/null 2>&1; then
			systemctl restart ssh || systemctl restart sshd
		else
			/etc/init.d/sshd restart
		fi
	fi

	passwd -u root 2>/dev/null || true
	echo "Setting password for root:"
	passwd root
}

cmd_user_setup() {
	user="${1:-${SUDO_USER:-}}"
	if [ -z "${user}" ] || [ "${user}" = "root" ]; then
		echo "error: cannot determine a non-root user; run '${PROG} user-setup <username>'" >&2
		return 1
	fi
	if ! id -u "${user}" >/dev/null 2>&1; then
		echo "error: user '${user}' does not exist" >&2
		return 1
	fi

	echo "Setting up AI SDK environment for user: ${user}"

	# SCHED_FIFO threads (r_osal_os_thread.c, r_osal_os_interrupt.c) need
	# rtprio. Applied at PAM login (including SSH).
	echo "${user} - rtprio 99" >/etc/security/limits.d/90-ai-sdk.conf

	# The TVM runtime fchmod()s this file before initializing OSAL, which
	# fails if root created it. Create it owned by the user on every boot.
	echo "f /tmp/tvm-rcar-osal-lock 0222 ${user} ${user} -" >/etc/tmpfiles.d/ai-sdk-tvm-osal-lock.conf
	systemd-tmpfiles --create /etc/tmpfiles.d/ai-sdk-tvm-osal-lock.conf
	# 'f' does not change the owner of an already existing file
	[ ! -e /tmp/tvm-rcar-osal-lock ] || chown "${user}:${user}" /tmp/tvm-rcar-osal-lock
	ls -l /tmp/tvm-rcar-osal-lock

	echo "Re-login (e.g. SSH) as ${user} to apply the rtprio limit; check with 'ulimit -r' (expect 99)."
}

cmd_user_reset() {
	echo "Removing AI SDK non-root user setup"
	rm -f /etc/security/limits.d/90-ai-sdk.conf
	rm -f /etc/tmpfiles.d/ai-sdk-tvm-osal-lock.conf
	rm -f /tmp/tvm-rcar-osal-lock
	echo "Done. Re-login to drop the rtprio limit; the lock file is created by the application on next run."
}

check_uio() {
	if ls /dev/uio* >/dev/null 2>&1; then
		return 0
	fi

	echo "warning: uio is not enabled. Boot U-Boot with: setenv conf_append '#uio'" >&2
	return 1
}

cmd_all() {
	cmd_lib_symlink
	cmd_unlock_root
}

check_uio || true

[ $# -ge 1 ] || usage
cmd="$1"
shift

case "${cmd}" in
lib-symlink)
	cmd_lib_symlink "$@"
	;;
unlock-root)
	cmd_unlock_root "$@"
	;;
user-setup)
	cmd_user_setup "$@"
	;;
user-reset)
	cmd_user_reset "$@"
	;;
all)
	cmd_all "$@"
	;;
*)
	usage
	;;
esac
